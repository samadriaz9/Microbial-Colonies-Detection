# Local development. Copy to .env and fill in. Do not commit .env.

ENV=development
DATABASE_URL=postgresql+psycopg://colony:colony@localhost:5432/colony
JWT_SECRET=replace-with-a-long-random-string
COOKIE_SECURE=false
APP_ORIGIN=http://localhost:8000

# Google "Continue with Google". The client ID is public; the secret stays on the server.
# In Google Cloud, add http://localhost:8000 as an authorized JavaScript origin.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional first account, created once on startup if the email is new.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

MODEL_PATH=best.pt
DATA_DIR=data
